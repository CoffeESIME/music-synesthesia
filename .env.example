# Modo web por defecto: no necesita puente, credenciales ni luces.
HUE_ENABLED=false

# Solo para el despliegue local con Hue (HUE_ENABLED=true).
BRIDGE_IP=
HUE_APPLICATION_KEY=
HUE_LIGHT_IDS=

# Puerto poco convencional publicado en el host.
SINESTESIA_HOST_PORT=18743
SINESTESIA_BIND_IP=0.0.0.0
SINESTESIA_HTTPS_PORT=18744
# IPv4 de la computadora que ejecuta Docker (no la del puente Hue).
SINESTESIA_LAN_HOST=192.168.1.100
